<configuration debug="false" scan="true" scanPeriod="20 seconds">
    <property scope="context" resource="application.yaml"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%date %level [%thread] %logger{5} - %msg %n %xEx</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="DEBUG"/>

    <logger name="org.springframework" level="ERROR">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="org.springframework.dao" level="DEBUG">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="org.springframework.boot" level="ERROR">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="ru.a2n.sfm" level="DEBUG">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="org.apache.http" level="DEBUG"/>

    <logger name="org.hibernate.exception" level="DEBUG">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="org.hibernate.engine" level="ERROR">
        <appender-ref ref="STDOUT"/>
    </logger>

    <logger name="org.springframework.kafka" level="ERROR">
        <appender-ref ref="STDOUT"/>
    </logger>

</configuration>
