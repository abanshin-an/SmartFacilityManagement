<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="0000" author="a2n">
        <preConditions>
            <dbms type="postgresql" />
        </preConditions>
        <sql>
            CREATE SCHEMA IF NOT EXISTS person_ms;
        </sql>
    </changeSet>
    <changeSet id="0001" author="a2n">
        <createTable tableName="person" schemaName="person_ms">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="person_full_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="person_login" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="person_email" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="person_phone" type="varchar(20)">
                <constraints nullable="true"/>
            </column>
            <column name="person_password" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
